# DATABASE (Supabase)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations and seed)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# AUTHENTICATION
# Generate different random values with at least 32 characters for each environment.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# SERVER
PORT=3000
NODE_ENV="development" # development | production
BACKEND_URL="http://localhost:3000"

# FRONTEND
FRONTEND_URL="http://localhost:4200"

# REDIS (Caching)
REDIS_HOST="localhost"
REDIS_PORT=6379

# I18N WEBHOOK
# Generate a unique random secret with at least 32 characters for each environment.
I18N_WEBHOOK_SECRET=""
I18N_WEBHOOK_TOLERANCE_SECONDS=300

# EMAIL (Optional - SendGrid/Resend)
# MAIL_PROVIDER=console # console | resend
# RESEND_API_KEY=re_123456789
# MAIL_FROM=kenneth.jesus@olustack.com.br

# ADMIN USER (for seed script)
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin Name"
