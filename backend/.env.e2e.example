# Copy to .env.e2e.local for local E2E runs. Never commit real values.
POSTGRES_PASSWORD=replace-with-local-compose-password
JWT_SECRET=replace-with-a-local-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-local-secret-of-at-least-32-characters
I18N_WEBHOOK_SECRET=replace-with-a-local-webhook-secret
REDIS_HOST=localhost
REDIS_PORT=6379
